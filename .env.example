# Database
DATABASE_URL=sqlite:///./jobtracker.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=

# Config files
COMPANIES_FILE=config/companies.yaml
USER_FILE=config/user.yaml

# Notifications (Phase 5, optional)
DISCORD_WEBHOOK_URL=

# Email notifications (FEAT-005).
# ALL optional. Leave SMTP_* blank to run in safe "outbox" mode: rendered
# emails are written to NOTIFY_OUTBOX_DIR and the NotificationLog instead of
# being sent (nothing crashes, no creds required). Fill these in to send real
# email through any SMTP provider.
#
# For Gmail: create an App Password (https://myaccount.google.com/apppasswords)
# with 2-Step Verification enabled and use it as SMTP_PASSWORD. Do NOT use your
# normal Gmail account password.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NOTIFY_FROM_EMAIL=
NOTIFY_DEFAULT_TO_EMAIL=
NOTIFY_OUTBOX_DIR=output/outbox
# Have the scheduler email new matches after each poll (safe default: false).
NOTIFY_ON_POLL=false

# AI provider (Phase 3, optional). KEY-READY: leave these blank to run without
# AI - the AI Analysis page and `analyze` command degrade gracefully with an
# "add a Gemini API key" message and never crash.
#
# To enable the built-in AI relevance engine, set AI_PROVIDER=gemini and put a
# REAL Google AI Studio API key in AI_API_KEY. Create a free key at
# https://aistudio.google.com/app/apikey -- a valid Gemini key looks like
# "AIza..." (about 39 characters).
#
# NOTE: a token like "AQ.Ab8RN6..." is an OAuth/other token, NOT a Gemini API
# key, and will almost certainly fail to authenticate. Use an AIza... key.
# Never commit your key; keep it only in this gitignored .env file.
AI_PROVIDER=
AI_API_KEY=
# Gemini model (defaults to gemini-1.5-flash). You can also use gemini-2.0-flash.
AI_MODEL=gemini-1.5-flash

# HTTP / connectors
HTTP_TIMEOUT=30.0
HTTP_MAX_RETRIES=3
RATE_LIMIT_PER_HOST=2.0
