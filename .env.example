# Database
DATABASE_URL=sqlite:///./jobtracker.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=

# Config files
COMPANIES_FILE=config/companies.yaml
USER_FILE=config/user.yaml

# Notifications (Phase 5, optional)
DISCORD_WEBHOOK_URL=

# Email notifications (FEAT-005; opt-in + exact-match in FEAT-004).
# ALL optional. Leave SMTP_* blank to run in safe "outbox" mode: rendered
# emails are written to NOTIFY_OUTBOX_DIR and the NotificationLog instead of
# being sent (nothing crashes, no creds required). Fill these in to send real
# email through any SMTP provider.
#
# Email is OPT-IN: no account receives email until it enables it on the
# Notifications page ("Enable email notifications"). Once opted in, emails fire
# ONLY on the user's exact-match "Relevant For Me" set (Stage-1 survivors
# INTERSECT the AI-eligible gate) -- never on broad or loosely-matching jobs.
#
# For Gmail: create an App Password (https://myaccount.google.com/apppasswords)
# with 2-Step Verification enabled and use it as SMTP_PASSWORD. Do NOT use your
# normal Gmail account password.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NOTIFY_FROM_EMAIL=
NOTIFY_DEFAULT_TO_EMAIL=
NOTIFY_OUTBOX_DIR=output/outbox
# Have the scheduler email new matches after each poll (safe default: false).
NOTIFY_ON_POLL=false
# Look-back window (minutes) for the post-poll notifier. Scopes the scan to
# just-detected changes so the work stays proportional to the poll.
NOTIFY_POLL_WINDOW_MINUTES=180
# NOTE: NOTIFY_DEFAULT_TO_EMAIL above is a single-user fallback only; with more
# than one account it is ignored so one user's matches are never misrouted.

# Gemini AI (Phase 3, optional). Leave blank to run without AI: the AI pages
# and commands show an "add a Gemini API key" message and never crash, and the
# "Relevant For Me" page falls back to the Stage-1 rule-based filter.
#
# Get a key at https://aistudio.google.com/apikey and paste it here. AI Studio
# keys start with "AQ."; any non-empty value is accepted (the format is not
# checked). This file is gitignored -- never commit your key.
GEMINI_API_KEY=
# Model. gemini-2.5-flash is no longer offered to new AI Studio users, and the
# standard flash models allow only 20 requests/day on the free tier, so the
# default is gemini-3.5-flash-lite (sub-second, same verdicts in testing).
GEMINI_MODEL=gemini-3.5-flash-lite
# Bulk AI pass throttle (Stage 2). The `screen-ai` command and the optional
# post-poll AI pass analyze ONLY the few hundred Stage-1 survivors, one at a
# time. Wait this many seconds BETWEEN provider calls to stay under the free
# tier's per-minute limit. If the DAILY quota runs out the pass stops cleanly
# and the remaining jobs are analyzed on the next run.
AI_REQUEST_DELAY_SECONDS=4.0
# Cap on NEW analyses per bulk run (blank = unlimited). With a cap, a first full
# backfill of the survivor set spreads across multiple runs, each staying within
# the free-tier rate limit; subsequent runs only analyze newly-seen survivors.
AI_BULK_MAX_PER_RUN=
# Have the scheduler run the bulk AI pass over each company's NEW Stage-1
# survivors after polling + screening (safe default: false, so plain CLI users
# and no-key deployments are unchanged).
AI_ANALYZE_ON_POLL=false

# HTTP / connectors
HTTP_TIMEOUT=30.0
HTTP_MAX_RETRIES=3
RATE_LIMIT_PER_HOST=2.0

# Scheduler (FEAT-003). Boards do not push to us, so the worker polls each
# source on its interval and surfaces accurate timestamps. SAFE defaults: the
# scheduler is OFF unless enabled, so plain CLI users see no behaviour change.
# On Fly.io the worker process sets SCHEDULER_ENABLED=true (see fly.toml).
SCHEDULER_ENABLED=false
# Hard ceiling (minutes) so NO company ever waits longer than ~1 hour per poll.
SCHEDULER_MAX_INTERVAL_MINUTES=60
# Per-priority default polling intervals (each still capped at the max above).
SCHEDULER_HIGH_INTERVAL_MINUTES=15
SCHEDULER_MEDIUM_INTERVAL_MINUTES=45
SCHEDULER_LOW_INTERVAL_MINUTES=60
